@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-white border-bottom shadow-sm">
            <span class="text-muted small">
                <i class="bi bi-mortarboard-fill text-primary"></i> <strong>Taller Universitario:</strong> Clean Architecture y Patrones en .NET 10
            </span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                Blazor Interactive Server
            </span>
        </div>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
