@page "/tickets/{Id:int}"

<PageTitle>HelpDesk - Detalle del Ticket #@Id</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-cone-striped text-warning me-2"></i>
                    Detalle del Ticket #@Id
                </h4>
            </div>
            <div class="card-body p-4 text-center text-muted">
                <p class="fs-5 mb-2">Esta vista está pendiente de implementación.</p>
                <p class="mb-0">
                    Complete el <strong>Reto Final</strong> usando <code>ITicketService</code>,
                    el <code>Result Pattern</code> y las reglas de negocio de la Capa Application.
                </p>
                <!-- TODO: Reto Final -->
            </div>
        </div>

        <div class="mt-3">
            <a href="tickets" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver al tablero
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }
}
